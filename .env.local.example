MONGODB_URI=mongodb://localhost:27017/quotes
CODEX_MODEL=gpt-5.5

# Optional. Set this if Next.js picks an older codex binary than your terminal.
# Example:
# CODEX_PATH=/Users/you/.nodebrew/current/bin/codex
CODEX_PATH=

# Optional. By default Codex runs in an empty temp directory so it cannot read
# this repository or .env.local while generating quotes.
CODEX_WORKDIR=

# Kept only as a note for WebSocket-based tutorials.
# This sample uses the provider's stdio mode and does not read this value.
CODEX_APP_SERVER_URL=ws://127.0.0.1:4500
